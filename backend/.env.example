PORT=3000

# Supabase Database & Auth Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# AI Engine & Speech-to-Text Configuration
# AI_TRANSCRIPTION_PROVIDER: 'gemini' | 'assemblyai'
AI_TRANSCRIPTION_PROVIDER=gemini
AI_TRANSCRIPTION_API_KEY=your-gemini-or-assemblyai-api-key
# Optional fallback:
OPENAI_API_KEY=
